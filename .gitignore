# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# development-only runtime artwork object store
/.var/

# misc
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.pem
*.tmp
*.temp
*.swp
*.swo
*~

# editors
.idea/
.vscode/
*.code-workspace

# debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log*

# env files
.env*
!.env.example

# local databases and Prisma development runtime state
.prisma/
prisma/.local/
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3
*.sqlite3-journal
*.pid

# generated Prisma client
/generated/prisma

# local editor skill bundles installed by Prisma CLI
/.agents/
/.claude/
/.windsurf/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

.vercel

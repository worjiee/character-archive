# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file or real database credentials.
DATABASE_URL="postgresql://CHARACTER_ARCHIVE_DB_USER:CHARACTER_ARCHIVE_DB_PASSWORD@localhost:5432/CHARACTER_ARCHIVE_DB_NAME?schema=public"

# Optional and development-only. Used by `prisma migrate dev`; staging and
# production deployments using `prisma migrate deploy` do not require it.
# Keep it separate from DATABASE_URL.
SHADOW_DATABASE_URL="postgresql://CHARACTER_ARCHIVE_DB_USER:CHARACTER_ARCHIVE_DB_PASSWORD@localhost:5433/CHARACTER_ARCHIVE_SHADOW_DB_NAME?schema=public"

# One-time, explicit initial administrator bootstrap inputs. Runtime login reads the
# User table; these variables are never used to authenticate requests or sign cookies.
# Generate the hash locally as documented in docs/DEVELOPMENT.md; never commit real values.
OWNER_USERNAME="OWNER_USERNAME_OR_EMAIL"
OWNER_PASSWORD_HASH="GENERATE_WITH_NPM_RUN_AUTH_HASH_PASSWORD"

# Exact Character Archive origins allowed to issue/receive browser-bridge pairings.
# Comma-separate explicit development/staging origins; never use a wildcard.
BRIDGE_ARCHIVE_ORIGINS="http://localhost:3000"

# Exact unpacked Chrome extension origin allowed to exchange one-time bridge codes.
# Load browser-extension/ once, copy its ID from chrome://extensions, and replace
# the placeholder. Comma-separate only explicitly approved companion origins.
BRIDGE_EXTENSION_ORIGINS="chrome-extension://REPLACE_WITH_UNPACKED_EXTENSION_ID"

# Development-only durable artwork provider. The local provider writes only
# generated content-addressed objects under .var/artwork/ and is rejected when
# NODE_ENV=production.
ARTWORK_STORAGE_PROVIDER="local"
# ARTWORK_LOCAL_ROOT="C:/absolute/development-only/path"

# Durable Preview and production artwork storage uses private Supabase Storage.
# ARTWORK_STORAGE_PROVIDER="supabase"
# DATABASE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# DATABASE_SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_SECRET"
# SUPABASE_ARTWORK_BUCKET="character-archive-artwork"

# Explicit deployment semantics. Keep production and Preview values separate.
# CHARACTER_ARCHIVE_DEPLOYMENT="preview"
# CHARACTER_ARCHIVE_RELEASE_CHANNEL="client-preview"
